<div id="<%= dom_id expenditure %>">
  <tr>
    <td>
      <%= expenditure.title %>
    </td>
    <td>
      <%= number_to_currency(expenditure.amount, unit: "GHC", precision: 2) %>
    </td>
    <td>
      <%= expenditure.category %>
    </td>
    <td>
      <%= expenditure.spent_on %>
    </td>
    <td>
      <%= expenditure.notes %>
    </td>
  </tr>

</div>
