<p style="color: green"><%= notice %></p>

<% content_for :title, "Loaders" %>

<h1>Loaders</h1>

<%= link_to "New loader", new_loader_path %>

<%= form_with url: loaders_path, method: :get, local: true do |form| %>
  <%= form.label :job_date, "Search by Job Date:" %>
  <%= form.date_field :job_date, value: params[:job_date] %>
  <%= form.submit "Search" %>
<% end %>

<div id="loaders">
  <table>
    <tr>
      <th>Job date:</th>
      <th>Name of client:</th>
      <th>Amount charged:</th>
      <th>Fuel:</th>
      <th>Balance:</th>
    </tr>
    <tr>
      <% @loaders.each do |loader| %>
        <%= render loader %>
      <% end %>
    </tr>
  </table>
</div>


